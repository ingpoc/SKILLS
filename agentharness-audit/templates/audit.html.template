    <footer>
      Generated by agentharness-audit v1.0 on {AUDIT_DATE}. Evidence source: direct codebase inspection of {KEY_FILES_INSPECTED}. Comparative baseline: Hermes · Claude Code · Codex CLI.
    </footer>
  </main>
</div>

<script>
// Active-link highlighter for sidebar TOC via IntersectionObserver
const links = document.querySelectorAll("nav.toc a[href^='#']");
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      links.forEach(l => l.classList.toggle("active",
        l.getAttribute("href") === "#" + e.target.id));
    }
  });
}, { rootMargin: "-40% 0px -50% 0px" });
links.forEach(a => {
  const el = document.getElementById(a.getAttribute("href").slice(1));
  if (el) obs.observe(el);
});
</script>
