#!/usr/bin/env bash
set -euo pipefail

resolve_root() {
  if [ -n "${SAVE_SESSION_ROOT:-}" ]; then
    (cd "$SAVE_SESSION_ROOT" && pwd -P)
    return
  fi

  local candidate="$PWD"
  while [ "$candidate" != "/" ]; do
    if [ -f "$candidate/.claude/session-data/CURRENT.md" ]; then
      printf '%s\n' "$candidate"
      return
    fi
    candidate="$(dirname "$candidate")"
  done

  if git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    if [ "$git_root" = "$HOME" ] && [ "$PWD" != "$HOME" ]; then
      printf '%s\n' "$PWD"
    else
      printf '%s\n' "$git_root"
    fi
  else
    printf '%s\n' "$PWD"
  fi
}

print_value() {
  local value="$1"
  local fallback="$2"
  if [ -n "$value" ]; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$fallback"
  fi
}

print_list() {
  local value="$1"
  local fallback="$2"
  if [ -n "$value" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      case "$line" in
        "-"*|"*"*) printf '%s\n' "$line" ;;
        *) printf -- '- `%s`\n' "$line" ;;
      esac
    done <<<"$value"
  else
    printf -- '- %s\n' "$fallback"
  fi
}

ROOT_DIR="$(resolve_root)"
SESSION_DIR="$ROOT_DIR/.claude/session-data"
SESSION_FILE="$SESSION_DIR/CURRENT.md"

HANDOFF_FOCUS="${SAVE_SESSION_HANDOFF_FOCUS:-}"
GOAL_OBJECTIVE="${SAVE_SESSION_GOAL_OBJECTIVE:-}"
GOAL_RESUME_POLICY="${SAVE_SESSION_GOAL_RESUME_POLICY:-ensure-active}"
WORKING_ON="${SAVE_SESSION_WORKING_ON:-${1:-Autogenerated session checkpoint. Verify current repo context before proceeding.}}"
BLOCKERS="${SAVE_SESSION_BLOCKERS:-${3:-*(none)*}}"
LEARNINGS="${SAVE_SESSION_LEARNINGS:-${4:-*(none)*}}"
VERIFICATION_STATE="${SAVE_SESSION_VERIFICATION_STATE:-*(not supplied)*}"
SESSION_INTROSPECTION="${SAVE_SESSION_INTROSPECTION:-*(not supplied)*}"
RELEVANT_FILES="${SAVE_SESSION_RELEVANT_FILES:-}"
RELEVANT_COMMITS="${SAVE_SESSION_RELEVANT_COMMITS:-}"
AVOID_NEXT_SESSION="${SAVE_SESSION_AVOID:-}"
USEFUL_COMMANDS="${SAVE_SESSION_USEFUL_COMMANDS:-}"
ROUTE_ID="${SAVE_SESSION_ROUTE_ID:-}"
ROUTE_OWNER="${SAVE_SESSION_ROUTE_OWNER:-}"
FIRST_COMMAND="${SAVE_SESSION_FIRST_COMMAND:-}"
STOP_CONDITION="${SAVE_SESSION_STOP_CONDITION:-}"
ALLOWED_BEFORE_FIRST_COMMAND="${SAVE_SESSION_ALLOWED_BEFORE_FIRST_COMMAND:-}"
AVOID_BEFORE_FIRST_COMMAND="${SAVE_SESSION_AVOID_BEFORE_FIRST_COMMAND:-}"
INCLUDE_GIT_STATUS="${SAVE_SESSION_INCLUDE_GIT_STATUS:-0}"
RESUME_WINDOW_HOURS="${SAVE_SESSION_RESUME_WINDOW_HOURS:-24}"

case "$GOAL_RESUME_POLICY" in
  ensure-active|reference-only) ;;
  *)
    printf 'SAVE_SESSION_GOAL_RESUME_POLICY must be ensure-active or reference-only, got: %s\n' "$GOAL_RESUME_POLICY" >&2
    exit 2
    ;;
esac

case "$RESUME_WINDOW_HOURS" in
  ''|*[!0-9]*)
    printf 'SAVE_SESSION_RESUME_WINDOW_HOURS must be an integer from 1 to 168, got: %s\n' "$RESUME_WINDOW_HOURS" >&2
    exit 2
    ;;
esac
if [ "$RESUME_WINDOW_HOURS" -lt 1 ] || [ "$RESUME_WINDOW_HOURS" -gt 168 ]; then
  printf 'SAVE_SESSION_RESUME_WINDOW_HOURS must be from 1 to 168, got: %s\n' "$RESUME_WINDOW_HOURS" >&2
  exit 2
fi

if [ -n "${SAVE_SESSION_NEXT_ACTION:-}" ]; then
  NEXT_ACTION="$SAVE_SESSION_NEXT_ACTION"
elif [ -n "${2:-}" ]; then
  NEXT_ACTION="$2"
elif [ -n "$FIRST_COMMAND" ]; then
  NEXT_ACTION="Run \`$FIRST_COMMAND\` first, then follow the route_contract stop condition before broader repo retrieval."
else
  NEXT_ACTION="Open CURRENT.md, run normal repo retrieval, and resume from the first incomplete change or validation step."
fi

if [ -z "$HANDOFF_FOCUS" ] && [ -n "$FIRST_COMMAND" ]; then
  HANDOFF_FOCUS="Resume from route_contract.first_command; avoid broad retrieval until the stop condition is checked."
fi

mkdir -p "$SESSION_DIR"

GIT_STATUS=""
ROOT_GIT_DIR="$(git -C "$ROOT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
if [ "$ROOT_GIT_DIR" = "$ROOT_DIR" ]; then
  BRANCH="$(git -C "$ROOT_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ -z "$BRANCH" ]; then
    BRANCH="unknown"
  fi
  LAST_COMMIT="$(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || echo unknown)"
  STATUS_COUNT="$(git -C "$ROOT_DIR" status --short 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$STATUS_COUNT" = "0" ]; then
    GIT_SUMMARY="clean"
  else
    GIT_SUMMARY="dirty: ${STATUS_COUNT} changed or untracked path(s); raw status omitted by default"
  fi

  EXCLUDE_FILE="$ROOT_DIR/.git/info/exclude"
  if [ -f "$EXCLUDE_FILE" ] && ! grep -Fqx '.claude/session-data/' "$EXCLUDE_FILE"; then
    printf '\n.claude/session-data/\n' >>"$EXCLUDE_FILE"
  fi

  if [ "$INCLUDE_GIT_STATUS" = "1" ]; then
    GIT_STATUS="$(git -C "$ROOT_DIR" status --short 2>/dev/null | head -n 40)"
  fi
else
  BRANCH="unknown"
  LAST_COMMIT="unknown"
  GIT_SUMMARY="not a git worktree"
fi

{
  printf '# Session checkpoint\n\n'
  printf '**time:** %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '**repo_root:** %s\n' "$ROOT_DIR"
  printf '**branch:** %s\n' "$BRANCH"
  printf '**last_commit:** %s\n' "$LAST_COMMIT"
  printf '**resume_window_hours:** %s\n' "$RESUME_WINDOW_HOURS"
  printf '**git_summary:** %s\n\n' "$GIT_SUMMARY"

  printf '## handoff_focus\n'
  print_value "$HANDOFF_FOCUS" "Resume from the next_action after verifying current repo state; no extra historical context supplied."
  printf '\n'

  printf '## codex_goal\n'
  if [ -n "$GOAL_OBJECTIVE" ]; then
    printf 'resume_policy: %s\n' "$GOAL_RESUME_POLICY"
    printf 'objective:\n%s\n' "$GOAL_OBJECTIVE"
  else
    printf '*(none supplied; do not infer a goal from working_on or next_action)*\n'
  fi
  printf '\n'

  printf '## working_on\n%s\n\n' "$WORKING_ON"
  printf '## next_action\n%s\n\n' "$NEXT_ACTION"
  printf '## blockers\n%s\n\n' "$BLOCKERS"
  printf '## learnings\n%s\n\n' "$LEARNINGS"
  printf '## verification_state\n%s\n\n' "$VERIFICATION_STATE"
  printf '## session_introspection\n%s\n\n' "$SESSION_INTROSPECTION"

  printf '## relevant_files\n'
  print_list "$RELEVANT_FILES" '*(none supplied; use normal repo/workflow retrieval before acting)*'
  printf '\n'

  printf '## relevant_commits\n'
  print_list "$RELEVANT_COMMITS" '*(none supplied)*'
  printf '\n'

  printf '## avoid_next_session\n'
  print_value "$AVOID_NEXT_SESSION" "Do not trust this checkpoint over live repo evidence; avoid expanding tactical notes into durable doctrine without user intent."
  printf '\n'

  printf '## route_contract\n'
  if [ -n "$FIRST_COMMAND" ] || [ -n "$ROUTE_OWNER" ] || [ -n "$ROUTE_ID" ]; then
    printf 'route_id: %s\n' "${ROUTE_ID:-unspecified}"
    printf 'route_owner: %s\n' "${ROUTE_OWNER:-unspecified}"
    printf 'first_command: %s\n' "$FIRST_COMMAND"
    printf 'stop_condition: %s\n' "${STOP_CONDITION:-unspecified}"
    printf 'allowed_before_first_command:\n'
    print_list "$ALLOWED_BEFORE_FIRST_COMMAND" '*(minimal root/session checks only)*'
    printf 'avoid_before_first_command:\n'
    print_list "$AVOID_BEFORE_FIRST_COMMAND" '*(none supplied)*'
  else
    printf '*(none supplied)*\n'
  fi
  printf '\n'

  printf '## useful_commands\n'
  if [ -n "$USEFUL_COMMANDS" ]; then
    print_list "$USEFUL_COMMANDS" '*(none supplied)*'
  else
    printf -- '- `resume-session`\n'
    printf -- '- `git status --short`\n'
    printf -- '- `workflow lint`\n'
  fi
  printf '\n'

  if [ "$INCLUDE_GIT_STATUS" = "1" ]; then
    printf '## git_status\n'
    if [ -n "$GIT_STATUS" ]; then
      printf '```text\n%s\n```\n' "$GIT_STATUS"
    else
      printf '*(clean or unavailable)*\n'
    fi
  fi
} >"$SESSION_FILE"

case "$NEXT_ACTION" in
  *"normal repo retrieval"*|*"first incomplete change"*|*"current repo context"*)
    if [ -z "$FIRST_COMMAND" ]; then
      printf 'save-session warning: generic next_action without SAVE_SESSION_FIRST_COMMAND; next resume may need broad retrieval.\n' >&2
    fi
    ;;
esac

printf 'Saved session checkpoint to %s\n' "$SESSION_FILE"
